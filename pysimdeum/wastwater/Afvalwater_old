import pysimdeum
import matplotlib.pyplot as plt
import xarray as xr
import pandas as pd

# Built a house (one-person household)
house = pysimdeum.built_house(house_type='one_person')
print(house)

# Show the inhabitants of a house
print("List of Users:")
print(house.users)

# Show water end-use devices present in the house
print("List of Devices:")
print(house.appliances)

# Simulate water consumption for house (xarray.DataArray)
consumption = house.simulate(num_patterns=100)

# Filter out 'OutsideTap' and select only 'totalflow' flowtype
wastewater = consumption.where(consumption.enduse != 'OutsideTap', drop=True).sel(flowtypes='totalflow')

# Summing over 'enduse' and 'user', and taking the mean over 'patterns'
tot_ww = wastewater.sum(['enduse', 'user']).mean(['patterns'])

# Build statistics from consumption (total flow)
tot_cons = consumption.sum(['enduse', 'user']).sel(flowtypes='totalflow').mean(['patterns'])
print(tot_cons)

# Plot both total consumption and total water flow
plt.figure(figsize=(10, 6))
tot_cons.plot(label='Total Water Flow')
tot_ww.plot(label='Total WasteWater Flow')
plt.title("Total Water Flow & WasteWater Flow over Time")
plt.xlabel("Time")
plt.ylabel("Water Flow")
plt.legend()
plt.show()
