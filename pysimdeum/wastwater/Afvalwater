import pysimdeum
import matplotlib.pyplot as plt
import xarray as xr
import pandas as pd
import numpy as np

# Bouw een huis (gezinshuishouden)
house = pysimdeum.built_house(house_type='family')
print(house)

# Toon de bewoners van een huis
print("List of Users:")
print(house.users)

# Toon water eindgebruik toestellen aanwezig in het huis
print("List of Devices:")
print(house.appliances)

# Simuleer waterverbruik voor het huishouden (xarray.DataArray)
consumption = house.simulate(num_patterns=100)

def adjust_flow_and_duration(data):
    min_size = min(len(data.enduse.values), len(data.time.values))

    for index in range(min_size):
        enduse = data.enduse.values[index]

        try:
            flow = float(data.sel(flowtypes='totalflow').isel(time=index).values.item())
            time = data.time.values[index] / np.timedelta64(1, 'm')
        except (ValueError, TypeError):
            continue

        if enduse in ['Shower', 'Ktap', 'Brtap']:
            continue 
        elif enduse == 'Bath':
            new_flow = 1
            new_time = round((flow * time * 60) / new_flow) / 60
            data.sel(flowtypes='totalflow').isel(time=index).data = flow * time / new_time
            data.time.values[index] = new_time * np.timedelta64(1, 'm')
        elif enduse == 'Wc':
            new_flow = 2
            new_time = round((flow * time * 60) / new_flow) / 60
            data.sel(flowtypes='totalflow').isel(time=index).data = flow * time / new_time
            data.time.values[index] = new_time * np.timedelta64(1, 'm')

    return data

# Pas de aanpassingsfunctie toe
consumption = adjust_flow_and_duration(consumption)

# Filter 'OutsideTap' en selecteer alleen 'totalflow' flowtype voor afvalwater
wastewater = consumption.where(consumption.enduse != 'OutsideTap', drop=True).sel(flowtypes='totalflow')

# Berekening van het totale verbruik en piekbelasting
tot_ww = wastewater.sum(['enduse', 'user']).mean(['patterns'])

total_water_consumption = wastewater.sum(['enduse', 'user']).sum(dim='time')
peak_load = tot_ww.max().values * 1000

print(f"Totaal Waterverbruik: {total_water_consumption} liter")
print(f"Piekbelasting van de waterafvoer: {peak_load} liter/tijdseenheid")

# Visualiseer alleen de totale afvalwaterstroom
plt.figure(figsize=(10, 6))
tot_ww.plot(label='Total WasteWater Flow')  
plt.title("Afvalwater simulatie")
plt.xlabel("Time (MM-DD-HH)")
plt.ylabel("Afvalwater (m3)")
plt.legend()
plt.show()
