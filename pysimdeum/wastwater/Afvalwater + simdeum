import pysimdeum
import matplotlib.pyplot as plt
import xarray as xr
import pandas as pd
import numpy as np

house = pysimdeum.built_house(house_type='family')
print(house)

print("List of Users:")
print(house.users)

print("List of Devices:")
print(house.appliances)

consumption = house.simulate(num_patterns=100)

def adjust_flow_and_duration(data):
    min_size = min(len(data.enduse.values), len(data.time.values))

    for index in range(min_size):
        enduse = data.enduse.values[index]

        try:
            flow = float(data.sel(flowtypes='totalflow').isel(time=index).values.item())
            time = data.time.values[index] / np.timedelta64(1, 'm')
        except (ValueError, TypeError):
            continue

        if enduse in ['Shower', 'Ktap', 'Brtap']:
            continue 
        elif enduse == 'Bath':
            new_flow = 1
            new_time = round((flow * time * 60) / new_flow) / 60
            data.sel(flowtypes='totalflow').isel(time=index).data = flow * time / new_time
            data.time.values[index] = new_time * np.timedelta64(1, 'm')
        elif enduse == 'Wc':
            new_flow = 2
            new_time = round((flow * time * 60) / new_flow) / 60
            data.sel(flowtypes='totalflow').isel(time=index).data = flow * time / new_time
            data.time.values[index] = new_time * np.timedelta64(1, 'm')

    return data

consumption = adjust_flow_and_duration(consumption)

wastewater = consumption.where(consumption.enduse != 'OutsideTap', drop=True).sel(flowtypes='totalflow')

tot_ww = wastewater.sum(['enduse', 'user']).mean(['patterns'])
tot_cons = consumption.sum(['enduse', 'user']).sel(flowtypes='totalflow').mean(['patterns'])
print(tot_cons)

plt.figure(figsize=(10, 6))
tot_cons.plot(label='Total Water Flow')
tot_ww.plot(label='Total WasteWater Flow')
plt.title("Total Water Flow & WasteWater Flow over Time")
plt.xlabel("Time")
plt.ylabel("Water Flow")
plt.legend()
plt.show()
